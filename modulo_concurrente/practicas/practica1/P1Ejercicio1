{Realice un programa para que un robot junte todas las flores de la avenida 1 y las deposite al final de dicha avenida. Al finalizar, debe informar la cantidad de flores depositadas y la cantidad de esquinas sin flores que encontró durante el recorrido.}
{a) Modifique el programa anterior para que el mismo robot realice lo mismo en las avenidas 1, 3 y 5.}
programa P1Ejercicio1
{modulos}
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:=cantFlores+1
  fin
  proceso dejarFlores
  comenzar
    mientras (HayFlorEnLaBolsa)
      depositarFlor
  fin
  proceso contEsquinasOFlores(ES cantFlores:numero; ES cantEsquinas:numero)
  comenzar
    si (HayFlorEnLaEsquina)
      juntarFlores(cantFlores)
    sino
      cantEsquinas:=cantEsquinas+1
  fin
  proceso recorrerAvenida(E avenida: numero; ES cantFlores:numero; ES cantEsquinas: numero)
  comenzar
    Pos(avenida, 1)
    contEsquinasOFlores(cantFlores, cantEsquinas)
    repetir 99
      contEsquinasOFlores(cantFlores, cantEsquinas)
      mover
    dejarFlores
  fin

areas
  ciudad: AreaC (1,1,100,100)

{robots}
robots
  robot recolector
  variables
    cantFlores:numero
    cantEsquinas:numero
    avenida:numero
  comenzar
    avenida:=1
    mientras (avenida <= 3)
      cantFlores:=0
      cantEsquinas:=0
      recorrerAvenida(avenida, cantFlores, cantEsquinas)
      Informar(cantFlores)
      Informar(cantEsquinas)
      avenida := avenida +1
  fin
  
variables
  r: recolector
comenzar
  AsignarArea(r, ciudad)
  Iniciar(r, 1,1) {esquina unica inicial (robot: r1)}
fin