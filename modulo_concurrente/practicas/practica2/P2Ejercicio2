{Realice un programa en el que 3 robots realizan una escalera de 4 escalones cada uno. Todos los escalones tienen un ancho fijo de 1, y un alto aleatorio entre 1 y 5. Al finalizar el recorrido, cada robot deberá enviar al robot jefe la cantidad de escalones que tenían más flores que papeles. Una vez que los tres robots finalizaron, el robot jefe deberá informar la suma de las cantidades enviadas por los 3 robots.}
{○ El robot jefe inicia en la esquina (1,1) }
{○ El robot 1 inicia en la esquina (2,1) }
{○ El robot 2 inicia en la esquina (20,1) }
{○ El robot 3 inicia en la esquina (40,1) }

programa P2Ejercicio2
procesos
  proceso juntarFlores(ES cantFlores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:=cantFlores+1
  fin
  proceso juntarPapeles(ES cantPapeles:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cantPapeles:=cantPapeles+1
  fin
  proceso hacerEscalon(ES contEscalones:numero)
  variables
    alto:numero
    cantFlores, cantPapeles:numero
  comenzar
    cantFlores:=0
    cantPapeles:=0
    juntarFlores(cantFlores)
    juntarFlores(cantPapeles)
    Random(alto,1,5)
    repetir alto
      mover
      juntarFlores(cantFlores)
      juntarFlores(cantPapeles)
    derecha
    mover
    juntarFlores(cantFlores)
    juntarFlores(cantPapeles)
    si (cantFlores > cantPapeles)
      contEscalones:=contEscalones+1
    repetir 3
      derecha
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot escalador
  variables
    contEscalones:numero
  comenzar
    contEscalones:=0
    repetir 4
      hacerEscalon(contEscalones)
    EnviarMensaje(contEscalones,jefe)
  fin
  robot coordinador
  variables
    cant,total:numero
  comenzar
    total:=0
    repetir 3
      RecibirMensaje(cant,*)
      total:=total+cant
    Informar(cant)
  fin
variables
  r1: escalador
  r2: escalador
  r3: escalador
  jefe: coordinador
comenzar
  AsignarArea(r1, ciudad)
  AsignarArea(r2, ciudad)
  AsignarArea(r3, ciudad)
  AsignarArea(jefe, ciudad)
  Iniciar(jefe, 1,1)
  Iniciar(r1, 2,1)
  Iniciar(r2, 20,1)
  Iniciar(r3, 40,1)
fin
